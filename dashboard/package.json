{
  "name": "kcore-dashboard",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "scripts": {
    "gen": "mkdir -p src/gen && ${PROTOC:-protoc} -I ../proto --plugin=protoc-gen-es=node_modules/.bin/protoc-gen-es --es_out=src/gen --es_opt=target=ts ../proto/controller.proto",
    "dev": "npm run gen && vite",
    "typecheck": "npm run gen && tsc --noEmit",
    "test": "npm run gen && vitest run",
    "build": "npm run gen && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@tanstack/react-query": "^5.75.0",
    "@tanstack/react-router": "^1.120.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vitest": "^3.2.7"
  }
}
