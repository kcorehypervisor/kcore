{
  "admin": {
    "listen": "unix//run/kcore-ingress/admin.sock|0600"
  },
  "apps": {
    "http": {
      "servers": {
        "kcore": {
          "listen": [
            "203.0.113.10:80",
            "203.0.113.10:443"
          ],
          "metrics": {},
          "routes": [
            {
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "selection_policy": {
                      "policy": "round_robin"
                    }
                  },
                  "transport": {
                    "protocol": "http",
                    "proxy_protocol": "v2",
                    "tls": {
                      "ca": {
                        "provider": "inline",
                        "trusted_ca_certs": [
                          ""
                        ]
                      },
                      "server_name": "payments.internal"
                    }
                  },
                  "upstreams": [
                    {
                      "dial": "192.168.40.50:8443"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "*.apps.example.com",
                    "pay.example.com"
                  ],
                  "path": [
                    "/*"
                  ]
                }
              ],
              "terminal": true
            }
          ]
        },
        "metrics": {
          "automatic_https": {
            "disable": true
          },
          "listen": [
            "0.0.0.0:2020"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "metrics"
                }
              ]
            }
          ]
        }
      }
    },
    "layer4": {
      "servers": {
        "tcp-5432": {
          "listen": [
            "203.0.113.10:5432"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "proxy",
                  "proxy_protocol": "v2",
                  "upstreams": [
                    {
                      "dial": [
                        "10.0.0.8:5432"
                      ]
                    },
                    {
                      "dial": [
                        "10.0.0.9:5432"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "tcp-8443": {
          "listen": [
            "203.0.113.10:8443"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "proxy",
                  "upstreams": [
                    {
                      "dial": [
                        "10.0.0.7:443"
                      ]
                    }
                  ]
                }
              ],
              "match": [
                {
                  "tls": {
                    "sni": [
                      "pg.example.com"
                    ]
                  }
                }
              ]
            }
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "ca": "https://acme-v02.api.letsencrypt.org/directory",
                "email": "ops@example.com",
                "module": "acme"
              }
            ],
            "subjects": [
              "pay.example.com"
            ]
          },
          {
            "issuers": [
              {
                "ca": "https://acme-v02.api.letsencrypt.org/directory",
                "challenges": {
                  "dns": {
                    "provider": {
                      "api_token": "{env.CLOUDFLARE_API_TOKEN}",
                      "name": "cloudflare"
                    }
                  },
                  "http": {
                    "disabled": true
                  },
                  "tls-alpn": {
                    "disabled": true
                  }
                },
                "email": "ops@example.com",
                "module": "acme"
              }
            ],
            "subjects": [
              "*.apps.example.com"
            ]
          }
        ]
      }
    }
  },
  "storage": {
    "module": "file_system",
    "root": "/var/lib/kcore/ingress/certmagic"
  }
}