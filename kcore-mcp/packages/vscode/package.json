{
  "name": "kcore-vscode",
  "displayName": "kcore",
  "description": "Operate kcore clusters and VMs from the editor. The agent asks you the questions Terraform would, then plans and applies through kctl.",
  "version": "0.1.0",
  "publisher": "kcore",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": ["AI", "Other"],
  "keywords": ["kcore", "mcp", "vm", "cluster", "terraform"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "kcore",
        "label": "kcore"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.101.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
