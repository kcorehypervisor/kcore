+    use crate::{PciClassCode, PciConfiguration, PciHeaderType};
+
+    struct IdentityVfio {
+        config: [u8; 256],
+    }
+
+    impl Vfio for IdentityVfio {
+        fn region_read(&self, index: u32, offset: u64, data: &mut [u8]) {
+            if index != VFIO_PCI_CONFIG_REGION_INDEX {
+                return;
+            }
+            let start = offset as usize;
+            for (i, byte) in data.iter_mut().enumerate() {
+                let pos = start + i;
+                *byte = if pos < self.config.len() {
+                    self.config[pos]
+                } else {
+                    0
+                };
+            }
+        }
+    }
+
+    struct IdleInterrupts;
+
+    impl InterruptManager for IdleInterrupts {
+        type GroupConfig = MsiIrqGroupConfig;
+
+        fn create_group(
+            &self,
+            _config: Self::GroupConfig,
+        ) -> std::io::Result<Arc<dyn InterruptSourceGroup>> {
+            unimplemented!("identity test does not create interrupt groups")
+        }
+
+        fn destroy_group(&self, _group: Arc<dyn InterruptSourceGroup>) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+
+    fn identity_config() -> [u8; 256] {
+        let mut config = [0u8; 256];
+        // vendor 0x10de, device 0x2237
+        config[0] = 0xde;
+        config[1] = 0x10;
+        config[2] = 0x37;
+        config[3] = 0x22;
+        // revision 0xa1, prog-if 0x00, subclass 0x02, class 0x03 (display)
+        config[8] = 0xa1;
+        config[9] = 0x00;
+        config[10] = 0x02;
+        config[11] = 0x03;
+        // subsystem vendor 0x10de, subsystem 0x14a0
+        config[0x2c] = 0xde;
+        config[0x2d] = 0x10;
+        config[0x2e] = 0xa0;
+        config[0x2f] = 0x14;
+        config
+    }
+
+    fn identity_common(config: [u8; 256]) -> VfioCommon {
+        let configuration = PciConfiguration::new(
+            0,
+            0,
+            0,
+            PciClassCode::Other,
+            &PciVfioSubclass::VfioSubclass,
+            None,
+            PciHeaderType::Device,
+            0,
+            0,
+            None,
+            None,
+        );
+        VfioCommon {
+            configuration,
+            mmio_regions: Vec::new(),
+            interrupt: Interrupt {
+                intx: None,
+                msi: None,
+                msix: None,
+            },
+            msi_interrupt_manager: Arc::new(IdleInterrupts),
+            legacy_interrupt_group: None,
+            vfio_wrapper: Arc::new(IdentityVfio { config }),
+            patches: std::collections::HashMap::new(),
+            x_nv_gpudirect_clique: None,
+        }
+    }
+
+    #[test]
+    fn read_vfio_identity_parses_config_dwords() {
+        let vfio = IdentityVfio {
+            config: identity_config(),
+        };
+        let ident = read_vfio_identity(&vfio);
+        assert_eq!(ident.vendor, 0x10de);
+        assert_eq!(ident.device, 0x2237);
+        assert_eq!(ident.revision, 0xa1);
+        assert_eq!(ident.prog_if, 0x00);
+        assert_eq!(ident.subclass, 0x02);
+        assert_eq!(ident.class, 0x03);
+        assert_eq!(ident.subsystem_vendor, 0x10de);
+        assert_eq!(ident.subsystem, 0x14a0);
+        assert!(matches!(
+            pci_class_code(0x03),
+            PciClassCode::DisplayController
+        ));
+        assert!(matches!(pci_class_code(0x11), PciClassCode::Other));
+    }
+
+    #[test]
+    fn read_config_register_returns_vfio_identity_despite_patch() {
+        let mut common = identity_common(identity_config());
+        common.patches.insert(
+            0,
+            ConfigPatch {
+                mask: 0xffff_ffff,
+                patch: 0x1eb8_10de,
+            },
+        );
+        assert_eq!(common.read_config_register(0), 0x2237_10de);
+        assert_eq!(common.read_config_register(2), 0x0302_00a1);
+        assert_eq!(common.read_config_register(11), 0x14a0_10de);
+    }
+}
