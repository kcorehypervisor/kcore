+    fn write_bar_to_device(
+        &self,
+        bar_id: u32,
+        bar_addr: u64,
+        region_type: PciBarRegionType,
+        flags: u32,
+    ) {
+        let bar_offset = if bar_id == VFIO_PCI_ROM_REGION_INDEX {
+            (PCI_ROM_EXP_BAR_INDEX * 4) as u32
+        } else {
+            PCI_CONFIG_BAR_OFFSET + bar_id * 4
+        };
+        let flag_bits = if bar_id == VFIO_PCI_ROM_REGION_INDEX {
+            flags & 0x1
+        } else if region_type == PciBarRegionType::IoRegion {
+            flags & 0b11
+        } else {
+            flags & 0b1111
+        };
+        self.vfio_wrapper
+            .write_config_dword(bar_offset, (bar_addr as u32) | flag_bits);
+        if region_type == PciBarRegionType::Memory64BitRegion {
+            let upper_offset = PCI_CONFIG_BAR_OFFSET + (bar_id + 1) * 4;
+            self.vfio_wrapper
+                .write_config_dword(upper_offset, (bar_addr >> 32) as u32);
+        }
+    }
